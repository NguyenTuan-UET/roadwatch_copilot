# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- RoadWatch demo server (src/roadwatch/web.py) ----
# RoadWatch needs no API key: everything runs offline on this machine.
RW_HOST=127.0.0.1          # 0.0.0.0 only inside Docker; compose publishes on 127.0.0.1
RW_PORT=8765
RW_RUNS_DIR=./runs/demo    # uploaded videos, annotated videos, decision logs
RW_KEEP_RUNS=20            # older runs (and their uploaded video) are deleted
RW_MAX_UPLOAD_MB=2048
RW_LOG_LEVEL=INFO
RW_USER=roadwatch
RW_PASSWORD=             # initial engineer password (at least 8 characters); existing accounts are preserved
RW_ACCOUNTS=1            # local SQLite accounts and sessions; 0 restores legacy HTTP Basic
RW_ACCOUNTS_DB=./runs/demo/accounts.db
RW_COOKIE_SECURE=0       # set 1 when deployed through HTTPS (including Tailscale Funnel)
# WebRTC preview only: STUN for direct connections; use [] for LAN/offline, add TURN for restrictive NAT.
RW_RTC_ICE_SERVERS='[{"urls":["stun:stun.cloudflare.com:3478"]}]'
