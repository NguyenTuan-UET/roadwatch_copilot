# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- RoadWatch demo server (src/roadwatch/web.py) ----
# RoadWatch needs no API key: everything runs offline on this machine.
RW_HOST=127.0.0.1          # 0.0.0.0 only inside Docker; compose publishes on 127.0.0.1
RW_PORT=8765
RW_RUNS_DIR=./runs/demo    # uploaded videos, annotated videos, decision logs
RW_KEEP_RUNS=20            # older runs (and their uploaded video) are deleted
RW_MAX_UPLOAD_MB=2048
RW_LOG_LEVEL=INFO
RW_USER=roadwatch
RW_PASSWORD=             # empty = no login (this machine only). REQUIRED before a tunnel or public URL
