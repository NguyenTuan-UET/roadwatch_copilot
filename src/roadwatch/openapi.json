      "title": "V Max Kmh",
      "type": "number"
     },
     "v_min_kmh": {
      "title": "V Min Kmh",
      "type": "number"
     }
    },
    "required": [
     "v_min_kmh",
     "v_max_kmh",
     "min_gap_m"
    ],
    "title": "LegalBand",
    "type": "object"
   },
