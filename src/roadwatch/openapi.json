{
 "components": {
  "schemas": {
   "AlertCounts": {
    "additionalProperties": false,
    "properties": {
     "emergency": {
      "default": 0,
      "title": "Emergency",
      "type": "integer"
     },
     "info": {
      "default": 0,
      "title": "Info",
      "type": "integer"
     },
     "warning": {
      "default": 0,
      "title": "Warning",
      "type": "integer"
     }
    },
    "title": "AlertCounts",
    "type": "object"
   },
   "BtBConfig": {
    "additionalProperties": false,
    "properties": {
     "cooldown_s": {
      "title": "Cooldown S",
      "type": "number"
     },
     "grace_s": {
      "title": "Grace S",
      "type": "number"
     },
     "h_m": {
      "title": "H M",
      "type": "number"
     },
     "h_ttc_s": {
      "title": "H Ttc S",
      "type": "number"
     },
     "info_horizon_s": {
      "title": "Info Horizon S",
      "type": "number"
     },
     "legal_bands": {
      "description": "Thông tư 38/2024 art. 11.1",
      "items": {
       "$ref": "#/components/schemas/LegalBand"
      },
      "title": "Legal Bands",
      "type": "array"
     },
     "phrases": {
      "additionalProperties": {
       "type": "string"
      },
      "propertyNames": {
       "$ref": "#/components/schemas/Level"
      },
      "title": "Phrases",
      "type": "object"
     },
     "t_clear_s": {
      "title": "T Clear S",
      "type": "number"
     },
     "t_confirm_s": {
      "title": "T Confirm S",
      "type": "number"
     },
     "ttc_emergency_s": {
      "title": "Ttc Emergency S",
      "type": "number"
     }
    },
    "required": [
     "legal_bands",
     "ttc_emergency_s",
     "h_ttc_s",
     "t_confirm_s",
     "h_m",
     "t_clear_s",
     "cooldown_s",
     "grace_s",
     "info_horizon_s",
     "phrases"
    ],
    "title": "BtBConfig",
    "type": "object"
   },
   "Calibration": {
    "additionalProperties": false,
    "properties": {
     "calibrated": {
      "description": "pitch/yaw converged and fy known: distance alerts allowed",
      "title": "Calibrated",
      "type": "boolean"
     },
     "coverage": {
      "description": "share of the model frame the camera image covers; < 0.95 = unreliable",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Coverage",
      "type": "number"
     },
     "fy_px": {
      "description": "focal length in use (px)",
      "title": "Fy Px",
      "type": "number"
     },
     "fy_state": {
      "description": "'nhập tay' | 'gom khung n/200 (tạm X)' | 'đang học nền (tạm X)' | 'đã học' | 'lỗi: …'",
      "title": "Fy State",
      "type": "string"
     },
     "height_m": {
      "description": "camera height above the road",
      "title": "Height M",
      "type": "number"
     },
     "pitch_deg": {
      "title": "Pitch Deg",
      "type": "number"
     },
     "remounts": {
      "description": "camera re-mounts detected in this run",
      "title": "Remounts",
      "type": "integer"
     },
     "status": {
      "description": "'calibrating k/5' | 'calibrated' | 'unreliable: <why>'",
      "title": "Status",
      "type": "string"
     },
     "yaw_deg": {
      "title": "Yaw Deg",
      "type": "number"
     }
    },
    "required": [
     "status",
     "calibrated",
     "fy_px",
     "fy_state",
     "pitch_deg",
     "yaw_deg",
     "height_m",
     "coverage",
     "remounts"
    ],
    "title": "Calibration",
    "type": "object"
   },
   "Decision": {
    "additionalProperties": false,
    "properties": {
     "latency_us": {
      "description": "time BT-B took for this frame",
      "title": "Latency Us",
      "type": "integer"
     },
     "level": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/Level"
       },
       {
        "type": "null"
       }
      ],
      "description": "active alert level; null = safe / silent"
     },
     "reason": {
      "description": "why it speaks or stays silent (Vietnamese, for the UI and the log)",
      "title": "Reason",
      "type": "string"
     },
     "say": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/Level"
       },
       {
        "type": "null"
       }
      ],
      "description": "phrase spoken on THIS frame; null = silent. Play /api/phrases/{say}"
     },
     "threshold_m": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "description": "legal minimum gap at the current speed; null below 60 km/h",
      "title": "Threshold M"
     }
    },
    "required": [
     "level",
     "say",
     "reason",
     "threshold_m",
     "latency_us"
    ],
    "title": "Decision",
    "type": "object"
   },
   "Deleted": {
    "additionalProperties": false,
    "properties": {
     "deleted": {
      "title": "Deleted",
      "type": "string"
     }
    },
    "required": [
     "deleted"
    ],
    "title": "Deleted",
    "type": "object"
   },
   "Error": {
    "additionalProperties": false,
    "properties": {
     "detail": {
      "description": "Vietnamese message to show as is (422 validation errors use FastAPI's list form)",
      "title": "Detail",
      "type": "string"
     }
    },
    "required": [
     "detail"
    ],
    "title": "Error",
    "type": "object"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "title": "Detail",
      "type": "array"
     }
    },
    "title": "HTTPValidationError",
    "type": "object"
   },
   "Health": {
    "additionalProperties": false,
    "properties": {
     "api_version": {
      "default": "1.2.0",
      "title": "Api Version",
      "type": "string"
     },
     "hung": {
      "title": "Hung",
      "type": "boolean"
     },
     "job": {
      "$ref": "#/components/schemas/RunState"
     },
     "model": {
      "description": "models/gr14VinAI.onnx present",
      "title": "Model",
      "type": "boolean"
     },
     "status": {
      "description": "'ok' | 'degraded' (a running job produced no frame for 2 s)",
      "title": "Status",
      "type": "string"
     },
     "timestamp": {
      "description": "ISO 8601, UTC",
      "title": "Timestamp",
      "type": "string"
     }
    },
    "required": [
     "status",
     "job",
     "hung",
     "model",
     "timestamp"
    ],
    "title": "Health",
    "type": "object"
   },
   "History": {
    "additionalProperties": false,
    "description": "GET /api/history: the last 600 chart samples (30 s), to fill the chart when the page opens mid-run.",
    "properties": {
     "run_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Run Id"
     },
     "samples": {
      "items": {
       "$ref": "#/components/schemas/Sample"
      },
      "title": "Samples",
      "type": "array"
     }
    },
    "required": [
     "run_id",
     "samples"
    ],
    "title": "History",
    "type": "object"
   },
   "Latency": {
    "additionalProperties": false,
    "properties": {
     "last_ms": {
      "description": "BT-A + BT-B time of the last frame",
      "title": "Last Ms",
      "type": "number"
     },
     "p50_ms": {
      "title": "P50 Ms",
      "type": "number"
     },
     "p95_ms": {
      "title": "P95 Ms",
      "type": "number"
     }
    },
    "required": [
     "last_ms",
     "p50_ms",
     "p95_ms"
    ],
    "title": "Latency",
    "type": "object"
   },
   "Lead": {
    "additionalProperties": false,
    "properties": {
     "delta_m": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "description": "Estimated gap minus radar reference (m); null without an aligned reference",
      "title": "Delta M"
     },
     "gap_m": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "description": "front bumper to lead vehicle; null when prob < 0.5",
      "title": "Gap M"
     },
     "prob": {
      "description": "model confidence that a lead vehicle exists",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Prob",
      "type": "number"
     },
     "radar_m": {
      "anyOf": [
       {
        "exclusiveMinimum": 0.0,
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "description": "Offline radar candidate distance at the same origin; null without reference data",
      "title": "Radar M"
     },
     "sigma_m": {
      "anyOf": [
       {
        "minimum": 0.0,
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "description": "Predicted lead-distance standard deviation (1 sigma), not measured accuracy; null when unavailable",
      "title": "Sigma M"
     },
     "speed_kmh": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "description": "lead vehicle speed; null when no lead",
      "title": "Speed Kmh"
     }
    },
    "required": [
     "prob",
     "gap_m",
     "speed_kmh"
    ],
    "title": "Lead",
    "type": "object"
   },
   "LegalBand": {
    "additionalProperties": false,
    "properties": {
     "min_gap_m": {
      "title": "Min Gap M",
